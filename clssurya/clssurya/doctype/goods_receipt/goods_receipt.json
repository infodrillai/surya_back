   "label": "Purchase Order",
   "options": "Purchase Entry",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "vendor",
   "fieldtype": "Link",
   "label": "Vendor",
   "options": "Vendor",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "posting_date",
   "fieldtype": "Date",
   "label": "Receipt Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nConfirmed\nCancelled",
   "default": "Draft",
   "in_list_view": 1
  },
  {
   "fieldname": "supplier_delivery_note",
   "fieldtype": "Data",
   "label": "Supplier Delivery Note",
   "in_list_view": 1
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "Goods Receipt Item"
  },
  {
   "fieldname": "total_qty",
   "fieldtype": "Float",
   "label": "Total Quantity Received",
   "precision": "9",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "precision": "9",
   "read_only": 1
  },
  {
   "fieldname": "confirmed_on",
   "fieldtype": "Datetime",
   "label": "Confirmed On",
   "read_only": 1
  },
  {
   "fieldname": "confirmed_by",
   "fieldtype": "Link",
   "label": "Confirmed By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "cancelled_on",
   "fieldtype": "Datetime",
   "label": "Cancelled On",
   "read_only": 1
  },
  {
   "fieldname": "cancelled_by",
   "fieldtype": "Link",
   "label": "Cancelled By",
   "options": "User",
   "read_only": 1
  }
 ],
 "field_order": [
  "purchase_order",
  "vendor",
  "posting_date",
  "status",
  "supplier_delivery_note",
  "remarks",
  "items",
  "total_qty",
  "total_amount",
  "confirmed_on",
  "confirmed_by",
  "cancelled_on",
  "cancelled_by"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Store",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ],
 "autoname": "format:GR-{#####}"
}