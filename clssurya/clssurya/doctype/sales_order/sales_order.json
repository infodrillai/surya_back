   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "order_date",
   "fieldtype": "Date",
   "label": "Order Date"
  },
  {
   "fieldname": "quotation",
   "fieldtype": "Link",
   "label": "Quotation",
   "options": "Quotation",
   "read_only": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Pending Approval\nApproved\nPartially Dispatched\nCompleted\nCancelled",
   "default": "Pending Approval",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "Sales Order Item"
  },
  {
  "fieldname": "subtotal",
  "fieldtype": "Currency",
  "label": "Subtotal",
  "precision": "9",
  "read_only": 1
},
{
  "fieldname": "discount_percent",
  "fieldtype": "Percent",
  "label": "Discount Percent",
  "default": "0"
},
{
  "fieldname": "discount_amount",
  "fieldtype": "Currency",
  "label": "Discount Amount",
  "precision": "9",
  "read_only": 1
},
{
  "fieldname": "taxable_amount",
  "fieldtype": "Currency",
  "label": "Taxable Amount",
  "precision": "9",
  "read_only": 1
},
{
  "fieldname": "gst_percent",
  "fieldtype": "Percent",
  "label": "GST Percent",
  "default": "18"
},
{
  "fieldname": "tax_amount",
  "fieldtype": "Currency",
  "label": "Tax Amount",
  "precision": "9",
  "read_only": 1
},
{
  "fieldname": "grand_total",
  "fieldtype": "Currency",
  "label": "Grand Total",
  "precision": "9",
  "read_only": 1,
  "in_list_view": 1
},
  {
   "fieldname": "below_cost",
   "fieldtype": "Check",
   "label": "Below Cost",
   "read_only": 1
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Link",
   "label": "Approved By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "approved_on",
   "fieldtype": "Datetime",
   "label": "Approved On",
   "read_only": 1
  },
  {
   "fieldname": "is_completed",
   "fieldtype": "Check",
   "label": "Is Completed",
   "read_only": 1,
   "default": 0,
   "in_list_view": 1,
   "no_copy": 1
  },
  {
   "fieldname": "completed_on",
   "fieldtype": "Datetime",
   "label": "Completed On",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "completed_by",
   "fieldtype": "Link",
   "label": "Completed By",
   "options": "User",
   "read_only": 1,
   "no_copy": 1
  }
 ],
"field_order": [
  "customer",
  "order_date",
  "quotation",
  "status",
  "items",
  "subtotal",
  "discount_percent",
  "discount_amount",
  "taxable_amount",
  "gst_percent",
  "tax_amount",
  "grand_total",
  "below_cost",
  "approved_by",
  "approved_on",
  "is_completed",
  "completed_on",
  "completed_by"
],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Sales",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Store",
   "read": 1
  }
 ],
 "autoname": "format:SO-{#####}"
}