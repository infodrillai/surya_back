{
 "doctype": "DocType",
 "name": "Sales Order",
 "module": "Clssurya",
 "engine": "InnoDB",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "editable_grid": 0,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
