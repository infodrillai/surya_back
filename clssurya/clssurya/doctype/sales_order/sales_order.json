{
 "doctype": "DocType",
 "name": "Sales Order",
 "module": "Clssurya",
 "engine": "InnoDB",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "editable_grid": 0,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "order_date",
   "fieldtype": "Date",
   "label": "Order Date"
  },
  {
   "fieldname": "quotation",
   "fieldtype": "Link",
   "label": "Quotation",
   "options": "Quotation",
   "read_only": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Pending Approval\nApproved\nPartially Dispatched\nCompleted",
   "default": "Pending Approval",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "Sales Order Item"
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "precision": "9",
   "read_only": 1
  },
  {
   "fieldname": "below_cost",
   "fieldtype": "Check",
   "label": "Below Cost",
   "read_only": 1
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Link",
   "label": "Approved By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "approved_on",
   "fieldtype": "Datetime",
   "label": "Approved On",
   "read_only": 1
  },
  {
   "fieldname": "is_completed",
   "fieldtype": "Check",
   "label": "Is Completed",
   "read_only": 1,
   "default": 0,
   "in_list_view": 1,
   "no_copy": 1
  },
  {
   "fieldname": "completed_on",
   "fieldtype": "Datetime",
   "label": "Completed On",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "completed_by",
   "fieldtype": "Link",
   "label": "Completed By",
   "options": "User",
   "read_only": 1,
   "no_copy": 1
  }
 ],
 "field_order": [
  "customer",
  "order_date",
  "quotation",
  "status",
  "items",
  "total_amount",
  "below_cost",
  "approved_by",
  "approved_on",
  "is_completed",
  "completed_on",
  "completed_by"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Sales",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Store",
   "read": 1
  }
 ],
 "autoname": "format:SO-{#####}"
}