   "options": "Belt Production\nPU Production\nBonding\nRoll Formation\nCoating\nCNC Parting\nCNC Operation\nExternal Grinding",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "production_reference",
   "fieldtype": "Data",
   "label": "Production Order / Job Reference",
   "in_list_view": 1
  },
  {
   "fieldname": "product",
   "fieldtype": "Link",
   "label": "Product",
   "options": "Product"
  },
  {
   "fieldname": "batch_id",
   "fieldtype": "Data",
   "label": "Batch ID"
  },
  {
   "fieldname": "process",
   "fieldtype": "Link",
   "label": "Process / Operation",
   "options": "Process"
  },
  {
   "fieldname": "machine",
   "fieldtype": "Link",
   "label": "Machine",
   "options": "CNC Machine"
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "Employee / Operator",
   "options": "Employee"
  },
  {
   "fieldname": "shift",
   "fieldtype": "Select",
   "label": "Shift",
   "options": "Morning\nEvening\nNight"
  },
  {
   "fieldname": "input_qty",
   "fieldtype": "Float",
   "label": "Input Quantity",
   "precision": "9"
  },
  {
   "fieldname": "good_qty",
   "fieldtype": "Float",
   "label": "Good Quantity",
   "precision": "9"
  },
  {
   "fieldname": "rejected_qty",
   "fieldtype": "Float",
   "label": "Rejected Quantity",
   "precision": "9",
   "reqd": 1,
   "in_list_view": 1
