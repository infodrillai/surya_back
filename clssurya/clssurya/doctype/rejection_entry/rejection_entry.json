   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "attachment",
   "fieldtype": "Attach Image",
   "label": "Attachment / Image"
  },
  {
   "fieldname": "source_doctype",
   "fieldtype": "Data",
   "label": "Source DocType",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "source_name",
   "fieldtype": "Data",
   "label": "Source Document",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "source_key",
   "fieldtype": "Data",
   "label": "Source Key",
   "unique": 1,
   "read_only": 1,
   "no_copy": 1
