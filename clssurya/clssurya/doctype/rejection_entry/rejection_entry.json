  {
   "fieldname": "pending_qty",
   "fieldtype": "Float",
   "label": "Pending Quantity",
   "precision": "9"
  },
  {
   "fieldname": "uom",
   "fieldtype": "Link",
   "label": "Unit of Measurement",
   "options": "UOM"
  },
  {
   "fieldname": "rejection_reason",
   "fieldtype": "Link",
   "label": "Rejection Reason",
   "options": "Rejection Reason"
  },
  {
   "fieldname": "rejection_status",
   "fieldtype": "Select",
   "label": "Rejection Status",
   "options": "Pending Inspection\nRework\nScrap\nInspection Hold\nApproved Rejection",
