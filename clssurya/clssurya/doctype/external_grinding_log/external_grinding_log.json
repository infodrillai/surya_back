{
 "doctype": "DocType",
 "name": "External Grinding Log",
 "module": "Clssurya",
 "engine": "InnoDB",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "EGL-.YYYY.-.######",
 "fields": [
  {
   "fieldname": "entry_type",
   "fieldtype": "Select",
   "label": "Entry Type",
   "options": "Outward\nInward",
   "default": "Outward",
   "in_list_view": 1
  },
  {
   "fieldname": "outward_entry",
   "fieldtype": "Link",
   "label": "Related Outward Entry",
   "options": "External Grinding Log",
   "in_list_view": 1
  },
  {
   "fieldname": "batch_no",
   "fieldtype": "Data",
   "label": "Batch Number",
   "in_list_view": 1
  },
  {
   "fieldname": "job_reference",
   "fieldtype": "Data",
   "label": "Job / Batch Reference",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "product",
   "fieldtype": "Link",
   "label": "Product",
   "options": "Product",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "vendor",
   "fieldtype": "Link",
   "label": "Vendor / Grinding Provider",
   "options": "Vendor",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "challan_no",
   "fieldtype": "Data",
   "label": "Challan / Dispatch Note No",
   "in_list_view": 1
  },
  {
   "fieldname": "outward_date",
   "fieldtype": "Date",
   "label": "Sent Date (Outward)",
   "in_list_view": 1
  },
  {
   "fieldname": "sent_qty",
   "fieldtype": "Float",
   "label": "Sent Quantity",
   "precision": "2",
   "in_list_view": 1
  },
  {
   "fieldname": "uom",
   "fieldtype": "Link",
   "label": "UOM",
   "options": "UOM",
   "default": "PCS"
  },
  {
   "fieldname": "inward_date",
   "fieldtype": "Date",
   "label": "Receipt Date (Inward)"
  },
  {
   "fieldname": "returned_qty",
   "fieldtype": "Float",
   "label": "Quantity Received Back",
   "precision": "2"
  },
  {
   "fieldname": "accepted_qty",
   "fieldtype": "Float",
   "label": "Accepted / Good Quantity",
   "precision": "2",
   "in_list_view": 1
  },
  {
   "fieldname": "rejected_qty",
   "fieldtype": "Float",
   "label": "Rejected Quantity",
   "precision": "2",
   "in_list_view": 1,
   "default": "0"
  },
  {
   "fieldname": "pending_qty",
   "fieldtype": "Float",
   "label": "Pending at Vendor",
   "precision": "2",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "rejection_reason",
   "fieldtype": "Link",
   "label": "Rejection Reason",
   "options": "Rejection Reason"
  },
  {
   "fieldname": "grinding_status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Dispatched\nPartially Received\nCompleted\nCancelled",
   "default": "Dispatched",
   "in_list_view": 1
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "Employee / Operator",
   "options": "Employee",
   "in_list_view": 1
  },
  {
   "fieldname": "rejection_status",
   "fieldtype": "Select",
   "label": "Rejection Status",
   "options": "Pending Inspection\nRework\nScrap\nInspection Hold\nApproved Rejection",
   "default": "Pending Inspection"
  },
  {
   "fieldname": "shift",
   "fieldtype": "Select",
   "label": "Shift",
   "options": "Morning\nEvening\nNight"
  },
  {
   "fieldname": "machine",
   "fieldtype": "Link",
   "label": "Internal Machine",
   "options": "CNC Machine"
  },
  {
   "fieldname": "process",
   "fieldtype": "Link",
   "label": "Process / Operation",
   "options": "Process"
  },
  {
   "fieldname": "received_qty",
   "fieldtype": "Float",
   "label": "Received Quantity",
   "precision": "2"
  },
  {
   "fieldname": "attachment",
   "fieldtype": "Attach",
   "label": "Attachment"
  },
  {
   "fieldname": "challan_attachment",
   "fieldtype": "Attach",
   "label": "Challan Attachment"
  }
 ],
 "field_order": [
  "entry_type",
  "outward_entry",
  "batch_no",
  "job_reference",
  "product",
  "vendor",
  "challan_no",
  "challan_attachment",
  "outward_date",
  "sent_qty",
  "uom",
  "inward_date",
  "returned_qty",
  "received_qty",
  "accepted_qty",
  "rejected_qty",
  "pending_qty",
  "rejection_reason",
  "grinding_status",
  "remarks",
  "attachment",
  "employee",
  "rejection_status",
  "shift",
  "machine",
  "process"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Production",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Store",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ]
}
