{
 "doctype": "DocType",
 "name": "External Grinding Log",
 "module": "Clssurya",
 "engine": "InnoDB",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "format:EGL-{YYYY}-{#####}",
 "fields": [
  {
   "fieldname": "job_reference",
   "fieldtype": "Data",
   "label": "Job / Batch Reference",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "product",
   "fieldtype": "Link",
   "label": "Product",
   "options": "Product",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "vendor",
   "fieldtype": "Link",
   "label": "Vendor / Grinding Provider",
   "options": "Vendor",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "challan_no",
   "fieldtype": "Data",
   "label": "Challan / Dispatch Note No",
   "in_list_view": 1
  },
  {
   "fieldname": "outward_date",
   "fieldtype": "Date",
   "label": "Sent Date (Outward)",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "sent_qty",
   "fieldtype": "Float",
   "label": "Sent Quantity",
   "precision": "2",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "uom",
   "fieldtype": "Link",
   "label": "UOM",
   "options": "UOM",
   "default": "PCS"
  },
  {
   "fieldname": "inward_date",
   "fieldtype": "Date",
   "label": "Receipt Date (Inward)"
  },
  {
   "fieldname": "returned_qty",
   "fieldtype": "Float",
   "label": "Quantity Received Back",
   "precision": "2"
  },
  {
   "fieldname": "accepted_qty",
   "fieldtype": "Float",
   "label": "Accepted / Good Quantity",
   "precision": "2",
   "in_list_view": 1
  },
  {
   "fieldname": "rejected_qty",
   "fieldtype": "Float",
   "label": "Rejected Quantity",
   "precision": "2",
   "in_list_view": 1
  },
  {
   "fieldname": "pending_qty",
   "fieldtype": "Float",
   "label": "Pending at Vendor",
   "precision": "2",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "rejection_reason",
   "fieldtype": "Data",
   "label": "Rejection Reason"
  },
  {
   "fieldname": "grinding_status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Dispatched\nPartially Received\nCompleted\nCancelled",
   "default": "Dispatched",
   "in_list_view": 1
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  }
 ],
 "field_order": [
  "job_reference",
  "product",
  "vendor",
  "challan_no",
  "outward_date",
  "sent_qty",
  "uom",
  "inward_date",
  "returned_qty",
  "accepted_qty",
  "rejected_qty",
  "pending_qty",
  "rejection_reason",
  "grinding_status",
  "remarks"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Production",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Store",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ]
}
