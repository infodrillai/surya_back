{
 "doctype": "DocType",
 "name": "Bonding Log",
 "module": "Clssurya",
 "engine": "InnoDB",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "format:BOND-{YYYY}-{#####}",
 "fields": [
  {
   "fieldname": "production_date",
   "fieldtype": "Date",
   "label": "Production Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "batch_reference",
   "fieldtype": "Data",
   "label": "Bonding Batch No / Reference",
   "in_list_view": 1
  },
  {
   "fieldname": "sheet_material",
   "fieldtype": "Select",
   "label": "Sheet Material",
   "options": "Oriented Sheet\nUnoriented Sheet\nWhite Fabric",
   "default": "Oriented Sheet",
   "in_list_view": 1
  },
  {
   "fieldname": "sheet_qty_kg",
   "fieldtype": "Float",
   "label": "Sheet / Fabric (KG)",
   "precision": "4"
  },
  {
   "fieldname": "ipa_qty",
   "fieldtype": "Float",
   "label": "IPA Qty",
   "precision": "4"
  },
  {
   "fieldname": "resorcinol_qty",
   "fieldtype": "Float",
   "label": "Resorcinol Qty",
   "precision": "4"
  },
  {
   "fieldname": "nylon_powder_kg",
   "fieldtype": "Float",
   "label": "Nylon Powder (KG)",
   "precision": "4"
  },
  {
   "fieldname": "bonding_output_kg",
   "fieldtype": "Float",
   "label": "Bonding Output Quantity (KG)",
   "precision": "4",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "machine",
   "fieldtype": "Link",
   "label": "Machine",
   "options": "CNC Machine"
  },
  {
   "fieldname": "operator",
   "fieldtype": "Data",
   "label": "Operator / Employee",
   "in_list_view": 1
  },
  {
   "fieldname": "shift",
   "fieldtype": "Select",
   "label": "Shift",
   "options": "Morning\nEvening\nNight",
   "default": "Morning",
   "in_list_view": 1
  },
  {
   "fieldname": "target_roll_id",
   "fieldtype": "Data",
   "label": "Allocated Roll ID / Downstream Roll"
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "Employee / Operator",
   "options": "Employee",
   "in_list_view": 1
  },
  {
   "fieldname": "rejection_reason",
   "fieldtype": "Link",
   "label": "Rejection Reason",
   "options": "Rejection Reason"
  },
  {
   "fieldname": "rejection_status",
   "fieldtype": "Select",
   "label": "Rejection Status",
   "options": "Pending Inspection\nRework\nScrap\nInspection Hold\nApproved Rejection",
   "default": "Pending Inspection"
  },
  {
   "fieldname": "input_qty",
   "fieldtype": "Float",
   "label": "Input Quantity",
   "precision": "9"
  },
  {
   "fieldname": "good_qty",
   "fieldtype": "Float",
   "label": "Good Quantity",
   "precision": "9"
  },
  {
   "fieldname": "rejected_qty",
   "fieldtype": "Float",
   "label": "Rejected Quantity",
   "precision": "9",
   "default": "0",
   "in_list_view": 1
  },
  {
   "fieldname": "pending_qty",
   "fieldtype": "Float",
   "label": "Pending Quantity",
   "precision": "9"
  },
  {
   "fieldname": "uom",
   "fieldtype": "Link",
   "label": "Unit of Measurement",
   "options": "UOM"
  },
  {
   "fieldname": "operation",
   "fieldtype": "Link",
   "label": "Process / Operation",
   "options": "Process"
  }
 ],
 "field_order": [
  "production_date",
  "batch_reference",
  "sheet_material",
  "sheet_qty_kg",
  "ipa_qty",
  "resorcinol_qty",
  "nylon_powder_kg",
  "bonding_output_kg",
  "machine",
  "operator",
  "shift",
  "target_roll_id",
  "remarks",
  "employee",
  "rejection_reason",
  "rejection_status",
  "input_qty",
  "good_qty",
  "rejected_qty",
  "pending_qty",
  "uom",
  "operation"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Production",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Store",
   "read": 1
  }
 ]
}
