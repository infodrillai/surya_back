{
 "doctype": "DocType",
 "name": "Product",
 "module": "Clssurya",
 "engine": "InnoDB",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "editable_grid": 0,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "product_name",
   "fieldtype": "Data",
   "label": "Product Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "product_code",
   "fieldtype": "Data",
   "label": "Product Code",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "product_type",
   "fieldtype": "Select",
   "label": "Product Type",
   "options": "Raw\nSemi\nFinished",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "uom",
   "fieldtype": "Link",
   "label": "UOM",
   "options": "UOM",
   "reqd": 1
  },
  {
   "fieldname": "is_scrap",
   "fieldtype": "Check",
   "label": "Is Scrap"
  },
  {
   "fieldname": "low_stock_limit",
   "fieldtype": "Float",
   "label": "Low Stock Limit",
   "precision": "9"
  },
  {
   "fieldname": "high_stock_limit",
   "fieldtype": "Float",
   "label": "High Stock Limit",
   "precision": "9"
  },
  {
   "fieldname": "category",
   "fieldtype": "Link",
   "label": "Category",
   "options": "Category"
  },
  {
   "fieldname": "total_steps",
   "fieldtype": "Int",
   "label": "Total Steps",
   "depends_on": "eval:doc.product_type!='Raw'"
  },
  {
   "fieldname": "allow_negative_stock",
   "fieldtype": "Check",
   "label": "Allow Negative Stock"
  },
  {
   "fieldname": "max_purchase_qty",
   "fieldtype": "Float",
   "label": "Max Purchase Quantity",
   "precision": "9",
   "default": "0"
  },
  {
   "fieldname": "production_code",
   "fieldtype": "Data",
   "label": "Production Code",
   "in_list_view": 1
  },
  {
   "fieldname": "finished_good_type",
   "fieldtype": "Select",
   "label": "Finished Good Type",
   "options": "PU\nBelt",
   "default": "PU",
   "depends_on": "eval:doc.product_type=='Finished'"
  },
  {
   "fieldname": "band_type",
   "fieldtype": "Select",
   "label": "Band Type",
   "options": "Grommed\nGrommed with Aluminium Patti\nLower\nUpper",
   "depends_on": "eval:doc.product_type=='Finished' && doc.finished_good_type=='Belt'"
  },
  {
   "fieldname": "belt_length",
   "fieldtype": "Float",
   "label": "Belt Length",
   "precision": "9",
   "depends_on": "eval:doc.product_type=='Finished' && doc.finished_good_type=='Belt'"
  },
  {
   "fieldname": "belt_width",
   "fieldtype": "Float",
   "label": "Belt Width",
   "precision": "9",
   "depends_on": "eval:doc.product_type=='Finished' && doc.finished_good_type=='Belt'"
  },
  {
   "fieldname": "hole",
   "fieldtype": "Float",
   "label": "Hole",
   "precision": "9",
   "depends_on": "eval:doc.product_type=='Finished' && doc.finished_good_type=='Belt'"
  }
 ],
 "field_order": [
  "product_name",
  "product_code",
  "product_type",
  "uom",
  "is_scrap",
  "low_stock_limit",
  "high_stock_limit",
  "category",
  "total_steps",
  "allow_negative_stock",
  "max_purchase_qty",
  "production_code",
  "finished_good_type",
  "band_type",
  "belt_length",
  "belt_width",
  "hole"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "CS Store",
   "read": 1
  },
  {
   "role": "CS Production",
   "read": 1
  },
  {
   "role": "CS Sales",
   "read": 1
  }
 ],
 "autoname": "field:product_code",
 "allow_rename": 1
}